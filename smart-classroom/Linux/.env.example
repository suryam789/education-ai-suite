COMPOSE_PROJECT_NAME=smart-classroom

VITE_API_BASE_URL=
SERVING_BASE_URL=http://ovms:9000
METRICS_COLLECTOR_URL=http://metrics-collector:9000

# setup.sh fills this in from the host's render group; required for GPU access.
RENDER_GID=

# On a TLS-inspecting corporate proxy, GPU/NPU downloads in the app,
# Audio Analyzer, and video-analytics provisioner builds can fail with
# "SSL: CERTIFICATE_VERIFY_FAILED" because the proxy re-signs outbound HTTPS
# with an internal CA the build image doesn't trust.
# Point this at a PEM file with that CA (often already trusted system-wide
# under /etc/ssl/certs on a corporate-managed host) to fix it; leave blank
# everywhere else — `--secret id=corporate_ca` is optional and a no-op without
# a valid CA file.
CORPORATE_CA_FILE=

HF_TOKEN=
